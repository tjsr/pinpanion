{
  "name": "pinnysets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "fuzzy": "^0.1.3",
    "node-fetch": "^3.3.2",
    "react": "^19.3.0",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "^19.3.0",
    "react-qr-code": "^2.2.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.3.2",
    "sparse-bit-string": "^0.2.3",
    "use-hash-param": "^0.3.1",
    "uuid": "^14.0.2"
  },
  "scripts": {
    "start:proxy": "node --loader ts-node/esm src/proxy.ts",
    "start": "cross-env BROWSER='chrome',BROWSER_ARGS='--remote-debugging-port=9222',PORT=5173,GENERATE_SOURCEMAP=false vite dev",
    "chrome-remote-debug": "chrome --remote-debugging-port=9222'",
    "build": "tsc && npm run ppschema && npm run download -- public/imgs && npm run build:vite",
    "build:vite": "vite build",
    "build:preview": "npm run ensure:preview-assets && vite build && vite preview",
    "build:amplify": "npm run ppschema && npm run download:amplify && npm run build:vite",
    "ppschema:prod": "node src/utils/dlschema.ts && npx openapi-typescript ./src/pinnypals/pinnypals-openapi-latest-public.json -o ./src/pinnypals/pp3schema.d.ts",
    "ppschema": "node src/utils/dlschema.ts -h https://api.pinnypals.dev && npx openapi-typescript ./src/pinnypals/pinnypals-openapi-latest-public.json -o ./src/pinnypals/pp3schema.d.ts",
    "dev": "vite dev",
    "download": "cross-env IMAGES_CACHE_DIR=images node --trace-warnings ./src/utils/pindownload.ts",
    "download:test": "cross-env TEST_MODE=true node ./src/utils/pindownload.ts",
    "download:testData": "cross-env TEST_MODE=true SKIP_ALL_IMAGES=true PINNYPALS_PINS_CACHE_FILE=test/pinsv3.json PINPANION_PINS_CACHE_FILE=test/pinpanion-pin-data.json node ./src/utils/pindownload.ts",
    "download:amplify": "cross-env IMAGES_CACHE_DIR=images node ./src/utils/pindownload.ts",
    "ensure:preview-assets": "node ./src/utils/ensurePreviewImageAssets.mjs",
    "test": "vitest --run && npm run lint",
    "lint": "eslint --fix \"./src/**/*.{ts,tsx}\"",
    "prettier": "prettier --single-quote --write \"./src/**/*.{ts,tsx}\"",
    "format": "npm run prettier && npm run lint",
    "ios": "node node_modules/react-native/local-cli/cli.js run-ios",
    "android": "node node_modules/react-native/local-cli/cli.js run-android",
    "clean": "rimraf images coverage build amplify public/images public/imgs public/pins.json",
    "clean:all": "npm run clean && rimraf node_modules"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tjsr/eslint-config": "github:tjsr/eslint-config#main",
    "@types/express": "^5.0.6",
    "@types/is-valid-path": "^0.1.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "commander": "^15.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "prettier-plugin-sort-members": "^0.2.5",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "web-vitals": "^6.2.2"
  },
  "overrides": {
    "tough-cookie": ">=4.1.3",
    "word-wrap": ">=1.2.5",
    "braces": ">=3.0.3",
    "ws": ">8.17.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11.5.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
